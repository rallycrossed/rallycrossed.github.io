---
import Layout from '../layouts/Layout.astro';

const slides = [
  { src: '/img/slides/slide-1.jpg', animation: 'kb-left' },
  { src: '/img/slides/slide-2.jpg', animation: 'kb-right' },
  { src: '/img/slides/slide-3.jpg', animation: 'kb-up' },
  { src: '/img/slides/slide-4.jpg', animation: 'kb-left' },
  { src: '/img/slides/slide-5.jpg', animation: 'kb-right' },
  { src: '/img/slides/slide-6.jpg', animation: 'kb-zoom' },
  { src: '/img/slides/slide-7.jpg', animation: 'kb-left' },
  { src: '/img/slides/slide-8.jpg', animation: 'kb-right' },
];

const SLIDE_DURATION = 6;   // seconds each slide is visible
const TOTAL = slides.length * SLIDE_DURATION; // 48s total cycle
---

<Layout>
  <!-- NAV -->
  <nav class="nav">
    <a href="/" class="nav-logo">
      <img src="/img/logo.png" alt="Rallycrossed" width="140" height="40" />
    </a>
    <ul class="nav-links">
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/about/">About</a></li>
    </ul>
  </nav>

  <!-- HERO -->
  <main class="hero">
    <!-- Ken Burns background slideshow -->
    <div class="slideshow" aria-hidden="true">
      {slides.map((slide, i) => (
        <div
          class={`slide slide-${i + 1}`}
          style={`background-image: url('${slide.src}'); animation-name: ${slide.animation}; animation-delay: ${i * SLIDE_DURATION}s;`}
        />
      ))}
      <!-- Dark overlay: vignette + bottom-to-top gradient -->
      <div class="overlay" />
      <!-- Animated speed lines canvas -->
      <canvas id="speed-canvas" aria-hidden="true" />
    </div>

    <!-- Content -->
    <div class="hero-content">
      <span class="badge">Premium Domain Available</span>

      <h1 class="hero-title">
        <span class="title-main">Rallycrossed</span>
        <span class="title-tld">.com</span>
      </h1>

      <p class="hero-tagline">
        The perfect domain for your Rallycross team, brand, or media operation.
      </p>

      <a href="mailto:Rallycrossed@christoc.com?subject=Rallycrossed.com%20Domain%20Inquiry" class="cta-btn">
        Inquire About Purchase
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-hint" aria-hidden="true">
      <span>Scroll</span>
      <svg width="16" height="24" viewBox="0 0 16 24" fill="none">
        <rect x="1" y="1" width="14" height="22" rx="7" stroke="currentColor" stroke-width="1.5"/>
        <circle class="scroll-dot" cx="8" cy="7" r="2.5" fill="currentColor"/>
      </svg>
    </div>
  </main>

  <!-- INFO SECTION -->
  <section class="info-section">
    <div class="info-grid">
      <div class="info-card">
        <div class="info-icon">🏁</div>
        <h3>Memorable Brand</h3>
        <p>Short, punchy, and instantly recognizable in the motorsport world. Rallycrossed says exactly what it is.</p>
      </div>
      <div class="info-card">
        <div class="info-icon">🌐</div>
        <h3>Premium .com</h3>
        <p>The gold standard of domains. A .com means credibility, trust, and global reach for your team or media brand.</p>
      </div>
      <div class="info-card">
        <div class="info-icon">⚡</div>
        <h3>Ready to Launch</h3>
        <p>Transfer within days. Start building your rallycross presence immediately with a domain that already has SEO history.</p>
      </div>
    </div>

    <div class="contact-block">
      <h2>Interested?</h2>
      <p>Reach out to discuss pricing and transfer details.</p>
      <div class="contact-actions">
        <a href="mailto:Rallycrossed@christoc.com?subject=Rallycrossed.com%20Domain%20Inquiry" class="cta-btn">
          Send an Email
        </a>
        <a href="https://twitter.com/Rallycrossed" target="_blank" rel="noopener" class="cta-btn cta-outline">
          @Rallycrossed
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-copy">&copy; {new Date().getFullYear()} Rallycrossed.com</p>
      <div class="footer-links">
        <a href="https://twitter.com/Rallycrossed" target="_blank" rel="noopener" title="Twitter">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a href="mailto:Rallycrossed@christoc.com" target="_blank" rel="noopener" title="Email">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </a>
        <a href="/feed.xml" title="RSS Feed">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/>
            <circle cx="5" cy="19" r="1" fill="currentColor"/>
          </svg>
        </a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* ─── Reset & base ─── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --accent:    #E8102A;
    --accent-hi: #ff2b44;
    --bg:        #080808;
    --surface:   #111111;
    --border:    rgba(255,255,255,0.08);
    --text:      #ffffff;
    --muted:     rgba(255,255,255,0.65);
    --font-display: 'Bebas Neue', sans-serif;
    --font-body:    'Inter', sans-serif;
    --slide-count: 8;
    --slide-secs: 6;
    --total-secs: 48; /* 8 * 6 */
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
  }

  /* ─── Nav ─── */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    background: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%, transparent 100%);
    pointer-events: none;
  }
  .nav a { pointer-events: all; }
  .nav-logo img { display: block; filter: brightness(0) invert(1); }
  .nav-links {
    list-style: none;
    display: flex;
    gap: 2rem;
  }
  .nav-links a {
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--accent-hi); }

  /* ─── Hero ─── */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ─── Slideshow ─── */
  .slideshow {
    position: absolute;
    inset: 0;
  }
  .slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    will-change: opacity, transform;
    animation-duration: calc(var(--total-secs) * 1s);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-fill-mode: both;
  }

  /* Ken Burns keyframes — 4 directions */
  @keyframes kb-left {
    0%      { opacity: 0; transform: scale(1.12) translate(2.5%, 0.5%); }
    1.04%   { opacity: 1; }
    11.46%  { opacity: 1; transform: scale(1.04) translate(0.5%, 0%); }
    12.5%   { opacity: 0; transform: scale(1.02) translate(0%, 0%); }
    12.51%  { transform: scale(1.12) translate(2.5%, 0.5%); }
    100%    { opacity: 0; transform: scale(1.12) translate(2.5%, 0.5%); }
  }
  @keyframes kb-right {
    0%      { opacity: 0; transform: scale(1.12) translate(-2.5%, 0.5%); }
    1.04%   { opacity: 1; }
    11.46%  { opacity: 1; transform: scale(1.04) translate(-0.5%, 0%); }
    12.5%   { opacity: 0; transform: scale(1.02) translate(0%, 0%); }
    12.51%  { transform: scale(1.12) translate(-2.5%, 0.5%); }
    100%    { opacity: 0; transform: scale(1.12) translate(-2.5%, 0.5%); }
  }
  @keyframes kb-up {
    0%      { opacity: 0; transform: scale(1.12) translate(0.5%, 2%); }
    1.04%   { opacity: 1; }
    11.46%  { opacity: 1; transform: scale(1.04) translate(0%, 0.5%); }
    12.5%   { opacity: 0; transform: scale(1.02) translate(0%, 0%); }
    12.51%  { transform: scale(1.12) translate(0.5%, 2%); }
    100%    { opacity: 0; transform: scale(1.12) translate(0.5%, 2%); }
  }
  @keyframes kb-zoom {
    0%      { opacity: 0; transform: scale(1.14) translate(-1%, -1%); }
    1.04%   { opacity: 1; }
    11.46%  { opacity: 1; transform: scale(1.04) translate(0%, 0%); }
    12.5%   { opacity: 0; transform: scale(1.01) translate(0%, 0%); }
    12.51%  { transform: scale(1.14) translate(-1%, -1%); }
    100%    { opacity: 0; transform: scale(1.14) translate(-1%, -1%); }
  }

  /* ─── Overlay ─── */
  .overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 80% at 50% 50%, transparent 30%, rgba(0,0,0,0.55) 100%),
      linear-gradient(
        to bottom,
        rgba(0,0,0,0.45) 0%,
        rgba(0,0,0,0.15) 25%,
        rgba(0,0,0,0.15) 65%,
        rgba(0,0,0,0.75) 100%
      );
    pointer-events: none;
    z-index: 2;
  }

  /* ─── Speed canvas ─── */
  #speed-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
    opacity: 0.45;
  }

  /* ─── Hero content ─── */
  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 0 1.5rem;
    max-width: 900px;
  }

  .badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-hi);
    border: 1px solid rgba(232, 16, 42, 0.6);
    background: rgba(232, 16, 42, 0.1);
    border-radius: 2rem;
    padding: 0.35em 1.1em;
    margin-bottom: 1.25rem;
    backdrop-filter: blur(6px);
    animation: fade-up 0.6s 0.2s both;
  }

  .hero-title {
    font-family: var(--font-display);
    line-height: 0.92;
    letter-spacing: 0.01em;
    animation: fade-up 0.7s 0.35s both;
  }
  .title-main {
    display: block;
    font-size: clamp(5rem, 16vw, 14rem);
    color: #fff;
    text-shadow: 0 2px 40px rgba(0,0,0,0.6);
  }
  .title-tld {
    display: block;
    font-size: clamp(3rem, 9vw, 8rem);
    color: var(--accent);
    margin-top: -0.1em;
    text-shadow: 0 0 60px rgba(232,16,42,0.5);
  }

  .hero-tagline {
    margin-top: 1.5rem;
    font-size: clamp(0.95rem, 2vw, 1.2rem);
    font-weight: 300;
    color: rgba(255,255,255,0.8);
    letter-spacing: 0.02em;
    animation: fade-up 0.7s 0.5s both;
  }

  .cta-btn {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.9em 2.4em;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 4px;
    border: 2px solid transparent;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    animation: fade-up 0.7s 0.65s both;
    box-shadow: 0 4px 24px rgba(232,16,42,0.4);
  }
  .cta-btn:hover {
    background: var(--accent-hi);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(232,16,42,0.55);
  }
  .cta-btn.cta-outline {
    background: transparent;
    border-color: rgba(255,255,255,0.35);
    color: rgba(255,255,255,0.85);
    box-shadow: none;
    animation: none;
  }
  .cta-btn.cta-outline:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.6);
    transform: translateY(-2px);
    box-shadow: none;
  }

  /* ─── Scroll hint ─── */
  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255,255,255,0.5);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    animation: fade-up 1s 1.2s both;
  }
  .scroll-dot {
    animation: scroll-dot 1.8s ease-in-out infinite;
  }
  @keyframes scroll-dot {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50%       { transform: translateY(9px); opacity: 0.3; }
  }

  /* ─── Info section ─── */
  .info-section {
    background: var(--bg);
    padding: 6rem 2rem;
  }
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    max-width: 1100px;
    margin: 0 auto 5rem;
  }
  .info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .info-card:hover {
    border-color: rgba(232,16,42,0.4);
    transform: translateY(-4px);
  }
  .info-icon { font-size: 2rem; margin-bottom: 1rem; }
  .info-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .info-card p {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .contact-block {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }
  .contact-block h2 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }
  .contact-block p {
    color: var(--muted);
    margin-bottom: 2rem;
    font-size: 1rem;
  }
  .contact-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ─── Footer ─── */
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 2rem;
  }
  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-copy { font-size: 0.8rem; color: var(--muted); }
  .footer-links { display: flex; gap: 1.25rem; }
  .footer-links a {
    color: var(--muted);
    transition: color 0.2s;
  }
  .footer-links a:hover { color: #fff; }

  /* ─── Animations ─── */
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── Mobile ─── */
  @media (max-width: 600px) {
    .nav { padding: 1rem 1.25rem; }
    .nav-logo img { width: 110px; }
    .info-section { padding: 4rem 1.25rem; }
    .scroll-hint { display: none; }
  }
</style>

<script>
  // Speed lines canvas animation
  const canvas = document.getElementById('speed-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  type Streak = {
    x: number; y: number;
    len: number; speed: number;
    opacity: number; width: number;
  };

  let streaks: Streak[] = [];
  let raf: number;

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    initStreaks();
  }

  function initStreaks() {
    const count = Math.floor((canvas.width * canvas.height) / 18000);
    streaks = Array.from({ length: count }, () => randomStreak(true));
  }

  function randomStreak(init = false): Streak {
    return {
      x: init ? Math.random() * canvas.width : canvas.width + 20,
      y: Math.random() * canvas.height,
      len: 15 + Math.random() * 70,
      speed: 2 + Math.random() * 6,
      opacity: 0.015 + Math.random() * 0.07,
      width: 0.5 + Math.random() * 1.2,
    };
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (const s of streaks) {
      const grad = ctx.createLinearGradient(s.x - s.len, s.y, s.x, s.y);
      grad.addColorStop(0, `rgba(255,255,255,0)`);
      grad.addColorStop(1, `rgba(255,255,255,${s.opacity})`);
      ctx.beginPath();
      ctx.moveTo(s.x - s.len, s.y);
      ctx.lineTo(s.x, s.y);
      ctx.strokeStyle = grad;
      ctx.lineWidth = s.width;
      ctx.stroke();
      s.x -= s.speed;
      if (s.x + s.len < 0) Object.assign(s, randomStreak());
    }
    raf = requestAnimationFrame(draw);
  }

  window.addEventListener('resize', resize, { passive: true });
  resize();
  draw();
</script>
