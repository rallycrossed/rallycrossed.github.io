---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Rallycrossed.com — Domain For Sale',
  description = 'Do you need the perfect domain for your Rallycross Team? Rallycrossed.com is available for purchase.',
  ogImage = '/img/slides/slide-6.jpg',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://rallycrossed.com/" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`https://rallycrossed.com${ogImage}`} />
    <meta property="og:url" content="https://rallycrossed.com/" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RXLH8ZKPEM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-RXLH8ZKPEM');
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
